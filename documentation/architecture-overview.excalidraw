    {
      "id": "overview_guardrails2_body",
      "type": "text",
      "x": 875,
      "y": 750,
      "width": 815,
      "height": 156,
      "strokeColor": "#64748b",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
