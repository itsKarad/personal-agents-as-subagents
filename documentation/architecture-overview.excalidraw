      "version": 1,
      "versionNonce": 100091,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "One queued request at a time; a filesystem lock\nserializes access to the linked WhatsApp session.\nOnly the chosen direct chat is accepted. Uncertain\nsends are never retried automatically.",
      "originalText": "One queued request at a time; a filesystem lock\nserializes access to the linked WhatsApp session.\nOnly the chosen direct chat is accepted. Uncertain\nsends are never retried automatically.",
      "fontSize": 17,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25
    },
