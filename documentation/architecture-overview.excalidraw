      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "Codex inspects the unified diff, check results, and\nsourceFilesUnchanged before accepting. The bridge\nnever edits the project worktree; only Codex applies\nan accepted patch while selected sources still match.",
      "originalText": "Codex inspects the unified diff, check results, and\nsourceFilesUnchanged before accepting. The bridge\nnever edits the project worktree; only Codex applies\nan accepted patch while selected sources still match.",
