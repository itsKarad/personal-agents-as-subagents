      "version": 1,
      "versionNonce": 100087,
      "isDeleted": false,
      "groupIds": [],
      "boundElements": null,
      "link": null,
      "locked": false,
      "text": "1–5 exact text files · ≤30,000 selected bytes\nTask ≤4,000 chars · up to 4 argv checks\nRejects secret paths/values, ignored files,\nsymlinks, binary data, and unsafe paths.",
      "originalText": "1–5 exact text files · ≤30,000 selected bytes\nTask ≤4,000 chars · up to 4 argv checks\nRejects secret paths/values, ignored files,\nsymlinks, binary data, and unsafe paths.",
