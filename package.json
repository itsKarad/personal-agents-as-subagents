{
  "name": "personal-instinct-bridge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test src/*.test.ts src/instinct/*.test.ts",
    "mcp": "node dist/src/mcp.js",
    "whatsapp-setup": "node --import tsx scripts/whatsapp-setup.ts",
    "install-local": "npm run build && node dist/src/install.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "baileys": "7.0.0-rc14",
    "pino": "10.4.0",
    "qrcode-terminal": "0.12.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode-terminal": "0.12.2",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
